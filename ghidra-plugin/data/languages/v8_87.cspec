<?xml version="1.0" encoding="UTF-8"?>

<!-- V8 Ignition: every JavaScript value is a 4-byte tagged slot (pointer
     compression). Functions take the receiver and their parameters in the
     receiver/a<i> frame slots and return the accumulator. -->
<compiler_spec>
  <data_organization>
    <absolute_max_alignment value="0"/>
    <machine_alignment value="1"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="4"/>
    <pointer_size value="4"/>
    <short_size value="2"/>
    <integer_size value="4"/>
    <long_size value="4"/>
    <long_long_size value="8"/>
    <float_size value="4"/>
    <double_size value="8"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="sp" space="ram"/>
  <default_proto>
    <prototype name="__v8_js" extrapop="0" stackshift="0">
      <input>
        <pentry minsize="1" maxsize="4">
          <register name="receiver"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a0"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a1"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a2"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a3"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a4"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a5"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a6"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a7"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a8"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a9"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a10"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a11"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a12"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a13"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a14"/>
        </pentry>
        <pentry minsize="1" maxsize="4">
          <register name="a15"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="4">
          <register name="acc"/>
        </pentry>
      </output>
    </prototype>
  </default_proto>
</compiler_spec>
